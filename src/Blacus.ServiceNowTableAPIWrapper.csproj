<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
	  <ImplicitUsings>disable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <RootNamespace />
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <Title>Blacus ServiceNow Table API Wrapper</Title>
	  <Version>10.2.1</Version>
	  <PackageId>Blacus.$(AssemblyName)</PackageId>
	  <Authors>Blacus</Authors>
	  <Product>Blacus.$(AssemblyName)</Product>
	  <PackageOutputPath>$(OutputPath)</PackageOutputPath>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <RepositoryUrl>https://github.com/Blacus-Software/Blacus.ServiceNowTableAPIWrapper</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.2.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.2" />
  </ItemGroup>

</Project>
